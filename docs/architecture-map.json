  "flows": [
    {
      "id": "login-2fa",
      "title": "Login, permisos y 2FA",
      "description": "El usuario ingresa, Spring Security carga credenciales desde PostgreSQL, aplica reglas por rol y, si corresponde, valida TOTP antes de permitir acceso.",
      "entrypoints": [
        "GET /login",
        "POST /login",
        "GET/POST /2fa/verify",
        "GET/POST /settings/2fa"
      ],
      "steps": [
        "browser",
        "security",
        "auth-controller",
        "user-domain",
        "repositories",
        "postgres",
        "two-factor",
        "session-control",
        "realtime-service"
      ]
    },
    {
      "id": "create-conversation",
      "title": "Nueva conversacion y guardado",
      "description": "El agente captura datos, el JS valida campos, timer y borrador local. HomeController guarda conversacion, fechas, estado, prioridad, agente, comercio y notas.",
      "entrypoints": [
        "GET /conversations/create",
        "POST /api/conversations/save"
      ],
      "steps": [
        "browser",
        "thymeleaf",
        "static-assets",
        "home-controller",
        "catalog-domain",
        "conversation-domain",
        "repositories",
        "postgres",
        "audit-service",
        "realtime-service"
      ]
    },
    {
      "id": "conversation-list",
      "title": "Listado, filtros y acciones masivas",
      "description": "La pantalla de conversaciones consulta datos filtrados por rol, permite ordenar, paginar, exportar seleccionados, reasignar, cambiar estado/prioridad y abrir vista rapida.",
      "entrypoints": [
        "GET /conversations",
        "POST /conversations/bulk/status",
        "POST /conversations/bulk/priority",
        "POST /conversations/bulk/assign",
        "POST /conversations/bulk/export"
      ],
      "steps": [
        "browser",
        "thymeleaf",
        "static-assets",
        "home-controller",
        "conversation-domain",
        "user-domain",
        "repositories",
        "postgres",
        "audit-service",
        "realtime-service"
      ]
    },
